{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": "$eslint-stylish",
      "group": "build"
    },
    {
      "label": "npm: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "npm: test:e2e",
      "type": "npm",
      "script": "test:e2e",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "npm: check:all",
      "type": "npm",
      "script": "check:all",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: catalog:build",
      "type": "npm",
      "script": "catalog:build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "catalog dry-run",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/build-ozon-catalog.mjs",
        "--dry-run"
      ],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
